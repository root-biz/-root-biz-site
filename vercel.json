{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "root-biz.vercel.app"
        }
      ],
      "destination": "https://www.root-biz.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.root-biz.com/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/service",
      "headers": [
        {
          "key": "Link",
